{
  "name": "jsoneditor",
  "version": "0.7.0",
  "private": true,
  "description": "Cross-platform JSON editor desktop application",
  "author": "JSONEditor contributors",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.16.0 <25",
    "pnpm": "12.15.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "postinstall": "install-electron",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:dev": "node tools/smoke-development.mjs",
    "test:performance": "node tools/run-performance-probe.mjs",
    "test:tree-performance": "node tools/run-tree-probe.mjs",
    "release:manifest": "node tools/release-manifest.mjs",
    "test:installed": "node tools/smoke-installed.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "build": "pnpm typecheck && electron-vite build",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:win": "pnpm build && electron-builder --win nsis --x64 --publish never",
    "build:linux": "pnpm build && node tools/build-linux.mjs"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jsdom": "30.1.3",
    "jsonc-parser": "3.3.1",
    "monaco-editor": "0.57.0",
    "prettier": "3.9.10",
    "react-arborist": "4.0.1",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
